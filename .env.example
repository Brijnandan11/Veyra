# Copy to .env and fill in your own values.
# NOTE: port 3000 is the usual default, but if a stale server holds it,
# bump this (e.g. 3001) and update the vite proxy target to match.
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=
# Use SUPABASE_SECRET_KEY (service role key) for server-side operations.
# Get it from Supabase Dashboard > Settings > API > service_role secret
SUPABASE_SECRET_KEY=
# Fallback: publishable key (anon key) - only works if RLS policies allow the operations
SUPABASE_PUBLISHABLE_KEY=
JWT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
